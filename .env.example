# Backend (read by backend/shared/paths.py). The CSI-Bench files are large and never go into git.
# export CSI_DATA_ROOT="/path/to/MotionSourceRecognition"

# Frontend: put this in frontend/.env.local (see frontend/.env.example).
# When set, module pages read GET <url>/api/<module>/replay and fall back to their bundled mock file.
# VITE_BACKEND_URL=http://localhost:8000
